# 本地开发用的示例值。复制为 .env 后按需修改；.env 不提交。
# 这些值只适用于本地 Compose，绝不能用于 staging 或生产。

# --- PostgreSQL（infra/compose）---
# 端口避开 5432/9000，以免与本机其他项目（如旧项目的 Compose）冲突
POSTGRES_PORT=55432
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_password
APP_DB_PASSWORD=app_dev_password
GATEWAY_DB_PASSWORD=gateway_dev_password

# 控制面：读写，运行迁移
DATABASE_URL=postgres://app:app_dev_password@localhost:55432/small0714
# Gateway：只读（角色 gateway_ro，见 ADR 0003）
GATEWAY_DATABASE_URL=postgres://gateway:gateway_dev_password@localhost:55432/small0714

# --- 对象存储（本地 MinIO，生产为 S3，见 ADR 0005）---
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
MINIO_ROOT_USER=minio_dev
MINIO_ROOT_PASSWORD=minio_dev_password
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=small0714-sites
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minio_dev
S3_SECRET_ACCESS_KEY=minio_dev_password

# --- 邮件（本地 Mailpit，UI: http://localhost:8025）---
SMTP_URL=smtp://localhost:1025
MAIL_FROM=no-reply@app.localhost

# --- 域名（本地模拟；真实域名在 W3 Day 4 验证，见 ADR 0001）---
APP_ORIGIN=http://app.localhost:3000
SITES_DOMAIN=sites.localhost

# --- Gateway ---
GATEWAY_ADDR=:8080
GATEWAY_HEALTH_ADDR=127.0.0.1:8081
